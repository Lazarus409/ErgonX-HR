DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=ergonx_hr
POSTGRES_USER=ergonx_hr
# Use a local-only password in your untracked `.env` file.
POSTGRES_PASSWORD=replace-with-local-postgres-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_CONN_MAX_AGE=60
POSTGRES_CONNECT_TIMEOUT=5
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
DJANGO_SECURE_HSTS_SECONDS=31536000
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=false
# Email stays disabled locally unless you intentionally configure an SMTP provider.
EMAIL_DELIVERY_ENABLED=false
# To exercise email flows (e.g. email OTP) locally without SMTP, set
# EMAIL_DELIVERY_ENABLED=true and write messages to media/dev-mail/ instead:
# EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
# Gmail / Google Workspace SMTP. Use a Google App Password, never the mailbox's
# normal password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-sending-account@example.com
EMAIL_HOST_PASSWORD=your-google-app-password
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=ErgonX <your-sending-account@example.com>
FRONTEND_PUBLIC_URL=http://localhost:3000
