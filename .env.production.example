# Copy to .env.production and replace every placeholder. Never commit it.
POSTGRES_DB=ergonx_hr_production
POSTGRES_USER=ergonx_hr_app
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DJANGO_SECRET_KEY=replace-with-a-random-django-secret-at-least-50-characters
DJANGO_ALLOWED_HOSTS=app.example.com,api.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3000
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
EMAIL_DELIVERY_ENABLED=false
# Gmail / Google Workspace SMTP. Use a Google App Password, never the mailbox's
# normal password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-sending-account@example.com
EMAIL_HOST_PASSWORD=replace-with-google-app-password
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=ErgonX HR <your-sending-account@example.com>
FRONTEND_PUBLIC_URL=https://app.example.com
# ErgonX HR edition: modules this product does not offer.
ERGONX_EXCLUDED_MODULES=PAYROLL,ACCOUNTING
